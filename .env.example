# Copy to .env and fill in. NEVER commit .env.
#
# FFmpeg is a system dependency, not a pip package. It must be on PATH (both
# `ffmpeg` and `ffprobe`). If it is installed somewhere unusual, point
# FFMPEG_BIN / FFPROBE_BIN at it - the renderer also searches the winget
# package directory automatically.

# ---------------------------------------------------------------------------
# Agnes clients (AI reasoning)
# ---------------------------------------------------------------------------
# Three separate clients consume this shared key. Source classification uses a
# fixed endpoint/model; audience relevance uses AGNES_BASE_URL and its optional
# path/auth settings; native ContextGuard uses AGNES_CHAT_COMPLETIONS_URL.
# Confirm the provider settings for each client against your supplied access.
# AGNES_API_KEY=
# AGNES_BASE_URL=https://<host>/v1
# AGNES_CHAT_PATH=/chat/completions
# AGNES_AUTH_HEADER=Authorization
# AGNES_AUTH_SCHEME=Bearer
# AGNES_MODEL=agnes-3.0-flash
# AGNES_TIMEOUT=90          # audience relevance client only
# AGNES_CHAT_COMPLETIONS_URL=https://<host>/v1/chat/completions

# The free/default 10 requests-per-minute limit is shared by calls using this
# key. Coordinate in-flight requests across clients; ContextGuard does not queue
# or retry Agnes requests.

# auto | agnes | rule_based  -- which engine scores audience relevance.
# auto uses Agnes only when AGNES_MODEL is set, and degrades to the
# deterministic engine if a call fails.
RELEVANCE_ENGINE=auto

# ---------------------------------------------------------------------------
# Meaning & Context Guard (Person 1)
# ---------------------------------------------------------------------------
# auto      -> use the native verifier through the pipeline bridge; unavailable
#               dependencies or verification fail closed
# local     -> require the native verifier; fail if it is unavailable
# disabled  -> development only; does not verify meaning
CONTEXT_GUARD_MODE=auto

# Source classification engine: how the transcript becomes topics, claims and
# relationships. auto tries Agnes once and falls back to the local
# deterministic heuristics on any provider failure, recording which engine
# produced the analysis; agnes pins the provider and fails closed; local
# never touches the network.
# CLASSIFICATION_ENGINE=auto

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# STORAGE_ROOT=./storage
# DATABASE_PATH=./storage/hackerring.db
# FIXTURES_DIR=./fixtures

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
# FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_BIN=C:/ffmpeg/bin/ffprobe.exe
RENDER_PRESET=veryfast
RENDER_CRF=21
RENDER_FPS=30
RENDER_TIMEOUT=900

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# Native ContextGuard reviewer (selected separately from CONTEXT_GUARD_MODE).
# Model and revision must be cached for offline deployments. The unified API
# loads the reviewer when first asked to verify; `python -m backend` preloads it.
CONTEXTGUARD_BACKEND=local_nli
CONTEXTGUARD_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
CONTEXTGUARD_MODEL_REVISION=6f5cf0a2b59cabb106aca4c287eed12e357e90eb
CONTEXTGUARD_DEVICE=auto
CONTEXTGUARD_OFFLINE=false
CONTEXTGUARD_BATCH_SIZE=8
CONTEXTGUARD_CPU_THREADS=4
CONTEXTGUARD_MAX_PAIRS=256
# CONTEXTGUARD_CACHE_DIR=/path/to/weights

# Frontend: copy app/.env.example to REPOSITORY ROOT .env.local before pnpm build.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Social publishing (backend only -- never NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
# Developer-app credentials below identify THIS app to each platform. They are
# NOT the per-account OAuth tokens created at connect time; those are stored
# encrypted in storage/social.sqlite3 after the user connects.
# Keep .env itself uncommitted (.env is gitignored); .env.example holds no secrets.
#
# Generate the mandatory token-encryption key (Fernet 32-byte base64 key):
#   pip install cryptography
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing SOCIAL_TOKEN_ENCRYPTION_KEY later makes previously connected
# credentials undecryptable. Back it up as a secret, outside source control.
# SOCIAL_TOKEN_ENCRYPTION_KEY=

# Backend base URL the browser calls AND the OAuth callback base (one backend
# identity). Must exactly match the redirect URIs registered in each developer
# app, and must equal the API hostname the browser uses (NEXT_PUBLIC_API_BASE_URL).
# Keep frontend and API same-site with consistent spelling (localhost everywhere,
# never mix localhost/127.0.0.1). A callback-only tunnel hostname here while the
# browser uses localhost does NOT work: the owner-cookie-bound callback arrives
# without the browser session cookie. If a provider needs public HTTPS, deploy
# frontend+API together over same-site HTTPS (scoped routes only).
# SOCIAL_API_BASE_URL=http://localhost:8000
# Exact browser origin allowed to start/finish the OAuth popup flow (same-site
# with the API; localhost frontend calling an unrelated tunnel domain is unsupported).
# SOCIAL_FRONTEND_ORIGIN=http://localhost:3000

# YouTube (Google Cloud OAuth web client; enable YouTube Data API v3).
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# X / Twitter (developer-app OAuth 2.0 confidential client with PKCE).
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# Instagram via Facebook Login for Business (Meta app; NOT plain Instagram Login).
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_GRAPH_VERSION=v25.0
