# Ignore secrets and generated media. Fixtures/demo_source.mp4 is intentionally
# NOT ignored: it is committed so the pipeline can be exercised on a clean
# checkout without running ffmpeg.
.env
.env.*
!.env.example

storage/
!storage/.gitkeep

