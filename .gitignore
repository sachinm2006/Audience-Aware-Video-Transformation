scratch_*
baseline.txt
run*.txt
*.log

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
.DS_Store

.next/
out/
*.tsbuildinfo

# Automated browser verification artefacts
.openchamber/
